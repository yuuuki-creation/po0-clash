{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "po0-clash",
  "identifier": "io.github.yuuukicreation.po0clash",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "po0-clash",
        "width": 980,
        "height": 660,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "yuuuki-creation",
    "homepage": "https://github.com/yuuuki-creation/po0-clash",
    "copyright": "yuuuki-creation",
    "shortDescription": "po0-clash",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "resources/mihomo.exe": "mihomo.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
